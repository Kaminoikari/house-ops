<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.house-ops.chrome-debug</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Google Chrome.app/Contents/MacOS/Google Chrome</string>
    <string>--remote-debugging-port=9222</string>
    <string>--user-data-dir=/Users/YOUR_USERNAME/house-ops/.chrome-profile</string>
    <string>--no-first-run</string>
    <string>--no-default-browser-check</string>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/house-ops/data/logs/chrome-debug.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/house-ops/data/logs/chrome-debug.err.log</string>

  <!-- Start at login + auto-restart if Chrome quits, so port 9222 is always live for scan-fb.mjs -->
  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
