<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.house-ops.chrome-debug</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Google Chrome.app/Contents/MacOS/Google Chrome</string>
    <string>--remote-debugging-port=9222</string>
    <string>--user-data-dir=/Users/YOUR_USERNAME/house-ops/.chrome-profile</string>
    <string>--no-first-run</string>
    <string>--no-default-browser-check</string>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/house-ops/data/logs/chrome-debug.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/house-ops/data/logs/chrome-debug.err.log</string>

  <!-- On-demand：不在登入時自動起、Chrome 退出時也不自動拉回。 -->
  <!-- run-daily.mjs 跑 FB scan 前會 launchctl kickstart 拉起、跑完 stop。 -->
  <!-- 首次登入 FB 或要手動跑 scan-fb.mjs 時：launchctl start com.house-ops.chrome-debug -->
  <key>RunAtLoad</key>
  <false/>

  <key>KeepAlive</key>
  <false/>
</dict>
</plist>
