<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.house-ops.daily</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/YOUR_USERNAME/house-ops/scripts/run-daily.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USERNAME/house-ops</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/house-ops/data/logs/daily.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/house-ops/data/logs/daily.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <!-- Daily report email notification (optional). See docs/email-setup.md -->
    <key>GMAIL_USER</key>
    <string>YOUR_GMAIL_ADDRESS@gmail.com</string>
    <key>GMAIL_APP_PASSWORD</key>
    <string>YOUR_16_CHAR_APP_PASSWORD</string>
    <key>NOTIFY_EMAIL_TO</key>
    <string>YOUR_RECIPIENT_ADDRESS@gmail.com</string>
    <!-- FB social group LLM extraction (optional). See lib/extract-fb-post.mjs -->
    <key>ANTHROPIC_API_KEY</key>
    <string>YOUR_ANTHROPIC_API_KEY</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>KeepAlive</key>
  <false/>
</dict>
</plist>
